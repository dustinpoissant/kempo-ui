{
  "customRoutes": {
    "/": "./index.html",
    "/kempo.min.css": "../node_modules/kempo-css/dist/kempo.min.css", 
    "/kempo-vars.css": "../kempo-vars.css",
    "/kempo-hljs.css": "../src/kempo-hljs.css",
    "/icons/**": "../icons/**",
    "/src/**": "../src/**"
  },
  "mimeTypes": {
    ".js": "application/javascript",
    ".mjs": "application/javascript"
  },
  "middleware": {
    "logging": {
      "enabled": true,
      "includeResponseTime": true
    }
  }
}
