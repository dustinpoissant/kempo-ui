{
  "name": "kempo-ui",
  "version": "0.4.16",
  "type": "module",
  "description": "A Lit based web-component library",
  "main": "index.js",
  "bin": {
    "kempo-icon": "./bin/icon.js",
    "kempo-geticon": "./bin/get_icon.js",
    "kempo-listicons": "./bin/list_icons.js",
    "kempo-highlightcode": "./bin/highlight_code.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "docs": "npx kempo-server --root docs --config docs/prod.config.json --port 8084",
    "dev": "npx kempo-server --root docs-src --port 8083",
    "icon": "node bin/icon.js",
    "geticon": "node bin/get_icon.js",
    "listicons": "node bin/list_icons.js",
    "highlightcode": "node bin/highlight_code.js",
    "test": "npx kempo-test -l minimal",
    "test:gui": "npx kempo-test --gui",
    "test:browser": "npx kempo-test -b",
    "test:node": "npx kempo-test -n"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinpoissant/kempo-ui.git"
  },
  "author": "Dustin Poissant",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dustinpoissant/issues"
  },
  "homepage": "https://github.com/dustinpoissant/kempo-ui#readme",
  "devDependencies": {
    "highlight.js": "^11.11.1",
    "js-beautify": "^1.15.4",
    "kempo-server": "^3.1.0",
    "kempo-testing-framework": "^1.4.6",
    "terser": "^5.43.1"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "kempo-css": "^2.2.3",
    "marked": "^18.0.2"
  }
}
